generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  createdAt    DateTime  @default(now())
  addresses    Address[]
  orders       Order[]
  cart         Cart?
}

model Product {
  id             String      @id @default(uuid())
  name           String
  description    String
  price          Float
  compareAtPrice Float?
  sku            String      @unique
  barcode        String?
  stock          Int         @default(0)
  unit           String
  minQuantity    Float       @default(1.0)
  stepQuantity   Float       @default(1.0)
  images         String      // Stored as JSON string
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  isActive       Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  weight         Float?
  createdAt      DateTime    @default(now())
  cartItems      CartItem[]
  orderItems     OrderItem[]
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  image    String?
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float   @default(1.0)
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        String      @default("PENDING")
  items         OrderItem[]
  addressId     String
  address       Address     @relation(fields: [addressId], references: [id])
  subtotal      Float
  deliveryFee   Float
  total         Float
  paymentMethod String
  paymentStatus String
  notes         String?
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Float
  unitPrice  Float
  totalPrice Float
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  line1     String
  line2     String?
  city      String
  region    String
  isDefault Boolean @default(false)
  orders    Order[]
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    @default("MANAGER")
  createdAt    DateTime  @default(now())
}
